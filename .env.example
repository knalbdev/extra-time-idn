# Copy this file to .env.local. Replace placeholders locally, never here.
# Browser-safe configuration; database access still requires RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Needed for server-side username lookup / Auth admin operations, not ordinary queries.
# Never prefix this with NEXT_PUBLIC_. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Optional device notifications. Generate once: npm run push:keys
# Public key is returned by /api/push/config; all other values stay server-only.
WEB_PUSH_PUBLIC_KEY=REPLACE_WITH_PUBLIC_KEY
WEB_PUSH_PRIVATE_KEY=REPLACE_WITH_PRIVATE_KEY
WEB_PUSH_SUBJECT=mailto:YOUR_ADMIN_EMAIL
# Random secret (at least 32 characters); scheduler sends Authorization: Bearer ...
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET
