# Copy this file to .env.local. Replace placeholders locally, never here.
# Browser-safe configuration; database access still requires RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only. Needed for server-side username lookup / Auth admin operations, not ordinary queries.
# Never prefix this with NEXT_PUBLIC_. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
